{
  "ConnectionStrings": {
    "DefaultConnection":
    "Server=localhost;Database=MyAppDb;User Id=${DB_USER};Password=${DB_PASSWORD};Encrypt=False;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JWT" : {
    "Issuer": "https://yourdomain.com",
    "Audience": "https://yourdomain.com",
    "SigningKey": "${JWT_SIGNING_KEY}"
  }
}